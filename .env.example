# ============================================
# CCTV Forensic Analyzer — Environment Template
# Copy to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================

# --- Application ---
APP_NAME=CCTV Forensic Analyzer
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=

# --- Database (PostgreSQL) ---
# Use psycopg3 driver. Example:
# postgresql+psycopg://cctv_user:your_password@localhost:5432/cctv_forensics
DATABASE_URL=postgresql+psycopg://cctv_user:CHANGE_ME@localhost:5432/cctv_forensics

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Storage ---
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=5368709120   # 5 GB in bytes
# List values must be JSON arrays (pydantic-settings v2.15+)
ALLOWED_EXTENSIONS=[".mp4",".mov",".avi",".mkv"]

# --- FFmpeg / FFprobe ---
# Binary name (if on PATH) or absolute path.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Background Workers (Celery + Redis) ---
# Not needed until Phase 16.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- CORS ---
# Comma-separated list of allowed origins.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Frame Analysis Defaults ---
FRAME_SAMPLING_RATES=[1,2,5]   # allowed frames-per-second sampling options
DEFAULT_FRAME_SAMPLING_RATE=1
SCENE_DIFF_THRESHOLD=0.35    # configurable frame-difference threshold

# --- Rate Limiting ---
LOGIN_RATE_LIMIT=5/minute

# --- Request Hardening ---
# Cap for non-multipart (JSON) request bodies, in bytes. Uploads are exempt.
MAX_REQUEST_BODY_SIZE=1048576   # 1 MB

# ============================================
# Docker Deployment (docker compose)
# Only needed when running via Docker. Set JWT_SECRET to a long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================
POSTGRES_USER=cctv_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=cctv_forensics
WEB_PORT=80
BACKEND_PORT=8000
