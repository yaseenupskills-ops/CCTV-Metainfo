# Backend environment template.
# Copy to .env and fill in real values. NEVER commit the real .env file.

# --- Application ---
APP_NAME=CCTV Forensic Analyzer
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=

# --- Database (PostgreSQL) ---
# Use psycopg3 driver.
DATABASE_URL=postgresql+psycopg://cctv_user:CHANGE_ME@localhost:5432/cctv_forensics

# --- Security ---
# REQUIRED. The app refuses to start if this is missing or still a placeholder.
# Generate your own:  python -c "import secrets; print(secrets.token_hex(32))"
#                  or: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Storage ---
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=5368709120
ALLOWED_EXTENSIONS=[".mp4",".mov",".avi",".mkv"]

# --- FFmpeg / FFprobe ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Background Workers (Celery + Redis) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Frame Analysis Defaults ---
FRAME_SAMPLING_RATES=[1,2,5]
DEFAULT_FRAME_SAMPLING_RATE=1
SCENE_DIFF_THRESHOLD=0.35

# --- Rate Limiting ---
LOGIN_RATE_LIMIT=5/minute

# --- Bootstrap Admin (first seed only) ---
# An existing admin is never modified, so restarts cannot reset a password.
# Leave ADMIN_PASSWORD empty to have a random one generated on first boot into
# storage/.admin_credentials (mode 0600). It is never printed to the logs.
ADMIN_EMAIL=admin@cctv.local
ADMIN_PASSWORD=
