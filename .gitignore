# ============================================
# Environment — never commit real values
# ============================================
.env
.env.*
!.env.example
*.local

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
.venv/
venv/
env/
ENV/
.python-version
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# ============================================
# Node / Frontend
# ============================================
node_modules/
frontend/dist/
frontend/build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================
# Evidence / Application Data (NEVER commit)
# ============================================
storage/
!storage/.gitkeep

# ============================================
# Database / Migrations
# ============================================
*.sqlite3
*.db

# ============================================
# Logs
# ============================================
logs/
*.log

# ============================================
# OS / Editor
# ============================================
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# ============================================
